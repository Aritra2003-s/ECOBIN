# EcoBin Backend Production & Development Environment Variables
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/waste_management?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.cbn6n4f.mongodb.net/waste_management?retryWrites=true&w=majority

# JWT Secret Key (Generate a random 32+ char hex string for production)
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters
JWT_EXPIRES_IN=7d

# Frontend URL for CORS (Set this to your Vercel deployment URL)
# Example: https://ecobin-frontend.vercel.app
CLIENT_URL=https://your-vercel-app.vercel.app

# OpenAI API Key (Optional — fallback mock inference is active if unset)
OPENAI_API_KEY=

# Maximum upload file size in Megabytes
MAX_FILE_SIZE_MB=10